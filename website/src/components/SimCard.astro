---
import SimIllustration from './SimIllustration.astro';
import { localePath, useT, type Locale } from '../i18n';
import type { SimInfo } from '../shared/sims';

interface Props {
  lang: Locale;
  sim: SimInfo;
}

const { lang, sim } = Astro.props;
const tr = useT(lang);
---

<a class="card" href={localePath(lang, sim.id)} style={`--accent: ${sim.accent}`}>
  <div class="card__art">
    <SimIllustration id={sim.id} />
    {!sim.ready && <span class="card__badge">{tr('sim.comingSoon')}</span>}
  </div>
  <div class="card__body">
    <h3>{tr(`sims.${sim.id}.title`)}</h3>
    <p>{tr(`sims.${sim.id}.blurb`)}</p>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface-raised);
    box-shadow: var(--shadow);
    color: inherit;
    text-decoration: none;
    border-top: 6px solid var(--accent);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }

  .card__art {
    position: relative;
  }

  .card__badge {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.92);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .card__body {
    padding: var(--space-4) var(--space-4) var(--space-2);
  }

  h3 {
    font-size: var(--text-lg);
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  p {
    color: var(--ink-2);
  }
</style>

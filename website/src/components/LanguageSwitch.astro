---
import { LOCALES, LOCALE_NAMES, localePath, useT, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  /** Current page path without the language prefix. */
  path: string;
}

const { lang, path } = Astro.props;
const tr = useT(lang);
---

<nav class="lang-switch" aria-label={tr('nav.language')}>
  {
    LOCALES.map((l) => (
      <a
        href={localePath(l, path)}
        hreflang={l}
        lang={l}
        data-lang={l}
        aria-current={l === lang ? 'true' : undefined}
        title={LOCALE_NAMES[l]}
      >
        {l.toUpperCase()}
      </a>
    ))
  }
</nav>

<script>
  // Remember an explicit choice so the root page doesn't override it with
  // the browser language next time. localStorage only, never sent anywhere.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('.lang-switch a[data-lang]')) {
    link.addEventListener('click', () => {
      try {
        localStorage.setItem('lang', link.dataset.lang ?? '');
      } catch {
        // Storage can be disabled (private mode, school policies); not needed to work
      }
    });
  }
</script>

<style>
  .lang-switch {
    display: flex;
    gap: var(--space-1);
    padding: var(--space-1);
    border-radius: 999px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--touch);
    min-height: calc(var(--touch) - 8px);
    padding-inline: var(--space-3);
    border-radius: 999px;
    color: var(--ink-2);
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration: none;
  }

  a[aria-current='true'] {
    background: var(--brand);
    color: var(--brand-ink);
  }
</style>

---
import Base from '../../../layouts/Base.astro';
import SimNav from '../../../components/SimNav.astro';
import Car from '../../../sims/car/Car.svelte';
import { localeStaticPaths, useT, type Locale } from '../../../i18n';

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const tr = useT(lang);
---

<Base lang={lang} title={tr('sims.car.title')} description={tr('sims.car.blurb')} path="car">
  <div class="container container--wide">
    <SimNav lang={lang} sim="car" current="sim" learn={false} quiz={false} />
    <p class="lead">{tr('sims.car.blurb')}</p>
    <Car client:load lang={lang} />

    <section class="what">
      <h2>{tr('car.whatTitle')}</h2>
      <p>{tr('car.whatText')}</p>
    </section>
  </div>
</Base>

<style>
  .lead {
    margin-top: calc(-1 * var(--space-2));
    color: var(--ink-2);
  }

  .what {
    max-width: 46rem;
    margin-top: var(--space-8);
    padding: var(--space-6);
    border-radius: var(--radius);
    background: var(--surface-raised);
    box-shadow: var(--shadow);
  }

  .what h2 {
    font-size: var(--text-xl);
  }

  .what p:last-child {
    margin-bottom: 0;
  }
</style>

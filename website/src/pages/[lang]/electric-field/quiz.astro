---
import { getEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SimNav from '../../../components/SimNav.astro';
import Quiz from '../../../ui/Quiz.svelte';
import { localePath, localeStaticPaths, tf, useT, type Locale } from '../../../i18n';

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const tr = useT(lang);
const entry = await getEntry('quiz', `${lang}/electric-field`);
if (!entry) throw new Error(`Missing quiz: ${lang}/electric-field`);
const { questions, bonus } = entry.data;
---

<Base lang={lang} title={`${tr('quiz.title')} · ${tr('sims.electric-field.title')}`} path="electric-field/quiz">
  <div class="container narrow">
    <SimNav lang={lang} sim="electric-field" current="quiz" learn={false} />
    <p class="intro">{tf(lang, 'quiz.intro', { total: questions.length })}</p>
    <Quiz client:load lang={lang} questions={questions} bonus={bonus} simUrl={localePath(lang, 'electric-field')} />
  </div>
</Base>

<style>
  .narrow {
    max-width: 46rem;
  }

  .intro {
    color: var(--ink-2);
  }
</style>

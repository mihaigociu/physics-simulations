---
import Base from '../../../layouts/Base.astro';
import SimNav from '../../../components/SimNav.astro';
import ElectricField from '../../../sims/electric-field/ElectricField.svelte';
import { localePath, localeStaticPaths, useT, type Locale } from '../../../i18n';

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const tr = useT(lang);
---

<Base lang={lang} title={tr('sims.electric-field.title')} description={tr('sims.electric-field.blurb')} path="electric-field">
  <div class="container container--wide">
    <SimNav lang={lang} sim="electric-field" current="sim" learn={false} />
    <p class="lead">{tr('sims.electric-field.blurb')}</p>
    <ElectricField client:load lang={lang} />

    <section class="what">
      <h2>{tr('field.whatTitle')}</h2>
      <p>{tr('field.whatText')}</p>
      <p class="links">
        <a class="button" href={localePath(lang, 'electric-field/quiz')}>{tr('field.quizCta')}</a>
      </p>
    </section>
  </div>
</Base>

<style>
  .lead {
    margin-top: calc(-1 * var(--space-2));
    color: var(--ink-2);
  }

  .what {
    max-width: 46rem;
    margin-top: var(--space-8);
    padding: var(--space-6);
    border-radius: var(--radius);
    background: var(--surface-raised);
    box-shadow: var(--shadow);
  }

  .what h2 {
    font-size: var(--text-xl);
  }

  .links {
    margin: 0;
  }
</style>
